{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "H TRANS",
  "version": "0.4.1",
  "identifier": "com.htrans.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "H TRANS",
        "width": 1280,
        "height": 760,
        "minWidth": 1000,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "H TRANS - نسخ واستعادة محادثات واتساب على Windows",
    "resources": ["resources/android-platform-tools.zip"]
  }
}
