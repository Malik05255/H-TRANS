{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "H TRANS",
  "version": "0.2.0",
  "identifier": "com.htrans.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "H TRANS",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Android WhatsApp chat backup and restore for Windows",
    "resources": ["resources/platform-tools"]
  }
}
