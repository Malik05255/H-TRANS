{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "H TRANS",
  "version": "0.6.4",
  "identifier": "com.htrans.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "H TRANS",
        "width": 1240,
        "height": 760,
        "minWidth": 1000,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "H TRANS - نسخ واستعادة محادثات واتساب على Windows",
    "resources": [
      "resources/android-platform-tools.zip",
      "resources/scrcpy-win64-v4.1.zip"
    ],
    "windows": {
      "nsis": {
        "languages": ["Arabic"],
        "displayLanguageSelector": false,
        "customLanguageFiles": { "Arabic": "windows/Arabic.nsh" },
        "sidebarImage": "windows/installer-sidebar.bmp",
        "headerImage": "windows/installer-header.bmp",
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  }
}
